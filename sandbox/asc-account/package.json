{
  "name": "arcscriptcenter-account-passkey-qa",
  "private": true,
  "type": "module",
  "description": "Staging-only Passkey WebAuthn experiments for Cloudflare Workers Free",
  "dependencies": {
    "@simplewebauthn/server": "14.1.0"
  },
  "devDependencies": {
    "esbuild": "0.27.0"
  },
  "scripts": {
    "build:passkey": "esbuild ./worker.mjs --bundle --platform=browser --target=es2022 --format=esm --loader:.txt=text --external:node:crypto --external:node:buffer --outfile=./dist/account-passkey-worker.mjs",
    "test:passkey": "node --test ./passkey.test.mjs ./login-pages.test.mjs"
  }
}
